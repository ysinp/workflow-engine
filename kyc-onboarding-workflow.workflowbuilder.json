{
  "name": "KYC Onboarding (converted from Camunda BPMN kycOnboardingProcess)",
  "layoutDirection": "RIGHT",
  "nodes": [
    {
      "id": "trigger-1",
      "type": "node",
      "position": { "x": 0, "y": 200 },
      "data": {
        "type": "trigger",
        "icon": "Lightning",
        "properties": {
          "label": "KYC Submitted",
          "description": "BPMN startEvent 'StartEvent_1'",
          "type": "eventBasedTrigger",
          "status": "active",
          "eventType": "apiCall",
          "condition": { "rule": "", "value": "" },
          "systemValue": ""
        }
      }
    },
    {
      "id": "action-verify-documents",
      "type": "node",
      "position": { "x": 280, "y": 200 },
      "data": {
        "type": "action",
        "icon": "PlayCircle",
        "properties": {
          "label": "Verify Documents",
          "description": "BPMN serviceTask 'verifyDocumentsTask' (camunda:delegateExpression=\"${documentVerificationDelegate}\"). Delegate execution has no direct built-in equivalent; represented as executeScript, the closest technical-action node type to an in-process delegate call.",
          "status": "active",
          "type": "executeScript",
          "executeScript": {
            "scriptLanguage": "javaScript",
            "scriptEditor": "return documentVerificationDelegate.execute(execution);",
            "scriptStoring": "docsValid",
            "passWorkflow": true
          }
        }
      }
    },
    {
      "id": "decision-docs-valid",
      "type": "node",
      "position": { "x": 560, "y": 200 },
      "data": {
        "type": "decision",
        "icon": "ArrowsSplit",
        "properties": {
          "label": "Documents Valid?",
          "description": "BPMN exclusiveGateway 'gatewayDocsValid'",
          "status": "active",
          "decisionBranches": [
            {
              "id": "valid",
              "sourceHandle": "source:inner:valid",
              "label": "Valid",
              "conditions": [
                { "x": "docsValid", "comparisonOperator": "isEqualTo", "y": "true", "logicalOperator": "" }
              ]
            },
            {
              "id": "invalid",
              "sourceHandle": "source:inner:invalid",
              "label": "Invalid",
              "conditions": [
                { "x": "docsValid", "comparisonOperator": "isEqualTo", "y": "false", "logicalOperator": "" }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "delay-request-additional-documents",
      "type": "node",
      "position": { "x": 560, "y": 460 },
      "data": {
        "type": "delay",
        "icon": "Timer",
        "properties": {
          "label": "Request Additional Documents",
          "description": "BPMN userTask 'requestAdditionalDocumentsTask' (camunda:candidateGroups=\"compliance\", camunda:dueDate=+3 days, form field 'docsValid': boolean). Workflow Builder has no native human-task/HITL node type (confirmed against the current built-in Nodes catalog and their own blog on the topic) - modeled as a delay awaiting an external signal carrying the human's resubmission decision. candidateGroups and dueDate are NOT expressible in the built-in delay schema; preserved below only as documentation. Also: the true 3-day SLA exceeds the built-in maxWaitTime enum's ceiling (24h) - a real schema gap, not silently rounded away.",
          "type": "conditionalDelay",
          "status": "active",
          "duration": {
            "timeUnits": "hours",
            "delayAmount": 0,
            "expression": "awaitSignal('requestAdditionalDocumentsCompleted'); candidateGroups=compliance; dueDate=P3D (exceeds built-in maxWaitTime ceiling of 24h)",
            "maxWaitTime": "24"
          }
        }
      }
    },
    {
      "id": "decision-docs-valid-retry",
      "type": "node",
      "position": { "x": 840, "y": 460 },
      "data": {
        "type": "decision",
        "icon": "ArrowsSplit",
        "properties": {
          "label": "Documents Valid? (Retry)",
          "description": "BPMN exclusiveGateway 'gatewayDocsValidRetry' (unnamed in source BPMN)",
          "status": "active",
          "decisionBranches": [
            {
              "id": "valid",
              "sourceHandle": "source:inner:valid",
              "label": "Valid",
              "conditions": [
                { "x": "docsValid", "comparisonOperator": "isEqualTo", "y": "true", "logicalOperator": "" }
              ]
            },
            {
              "id": "still-missing",
              "sourceHandle": "source:inner:still-missing",
              "label": "Still Missing",
              "conditions": [
                { "x": "docsValid", "comparisonOperator": "isEqualTo", "y": "false", "logicalOperator": "" }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "action-risk-scoring",
      "type": "node",
      "position": { "x": 1120, "y": 200 },
      "data": {
        "type": "action",
        "icon": "PlayCircle",
        "properties": {
          "label": "Calculate Risk Score",
          "description": "BPMN serviceTask 'riskScoringTask' (camunda:delegateExpression=\"${riskScoringDelegate}\"). Reached from both the direct-valid path and the post-retry-valid path, matching the BPMN's two incoming sequence flows onto this task.",
          "status": "active",
          "type": "executeScript",
          "executeScript": {
            "scriptLanguage": "javaScript",
            "scriptEditor": "return riskScoringDelegate.execute(execution);",
            "scriptStoring": "riskLevel",
            "passWorkflow": true
          }
        }
      }
    },
    {
      "id": "decision-risk-level",
      "type": "node",
      "position": { "x": 1400, "y": 200 },
      "data": {
        "type": "decision",
        "icon": "ArrowsSplit",
        "properties": {
          "label": "Risk Level?",
          "description": "BPMN exclusiveGateway 'gatewayRiskLevel'",
          "status": "active",
          "decisionBranches": [
            {
              "id": "low-medium",
              "sourceHandle": "source:inner:low-medium",
              "label": "Low / Medium Risk",
              "conditions": [
                { "x": "riskLevel", "comparisonOperator": "isNotEqualTo", "y": "HIGH", "logicalOperator": "" }
              ]
            },
            {
              "id": "high",
              "sourceHandle": "source:inner:high",
              "label": "High Risk",
              "conditions": [
                { "x": "riskLevel", "comparisonOperator": "isEqualTo", "y": "HIGH", "logicalOperator": "" }
              ]
            }
          ]
        }
      }
    },
    {
