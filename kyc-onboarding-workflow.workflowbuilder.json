        "properties": {
          "label": "Compliance Approval",
          "description": "BPMN userTask 'complianceApprovalTask' (camunda:candidateGroups=\"compliance\", camunda:dueDate=+3 days, form field 'approved': boolean). Reached from both the low/medium-risk path and the EDD-cleared path, matching the BPMN's two incoming sequence flows onto this task. Same HITL gap as the other human tasks in this process.",
          "type": "conditionalDelay",
          "status": "active",
          "duration": {
            "timeUnits": "hours",
            "delayAmount": 0,
            "expression": "awaitSignal('complianceApprovalCompleted'); candidateGroups=compliance; dueDate=P3D (exceeds built-in maxWaitTime ceiling of 24h)",
            "maxWaitTime": "24"
          }
        }
