      "position": { "x": 1400, "y": 460 },
      "data": {
        "type": "delay",
        "icon": "Timer",
        "properties": {
          "label": "Enhanced Due Diligence Review",
          "description": "BPMN userTask 'enhancedDueDiligenceTask' (camunda:candidateGroups=\"complianceSenior\", camunda:dueDate=+5 days, form field 'eddCleared': boolean). Same HITL gap as the other human tasks in this process - modeled as a delay awaiting an external signal. The true 5-day SLA exceeds the built-in maxWaitTime enum's ceiling (24h).",
          "type": "conditionalDelay",
          "status": "active",
          "duration": {
            "timeUnits": "hours",
            "delayAmount": 0,
            "expression": "awaitSignal('enhancedDueDiligenceCompleted'); candidateGroups=complianceSenior; dueDate=P5D (exceeds built-in maxWaitTime ceiling of 24h)",
            "maxWaitTime": "24"
          }
        }
